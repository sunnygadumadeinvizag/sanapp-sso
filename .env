# IIPE SSO — local development environment
DATABASE_URL="postgresql://sso_user:sso_dev_password@localhost:5432/sanapp_sso_db"

# Public URL of this SSO instance
SSO_BASE_URL="http://localhost:3000/sso"
MAIN_BASE_URL="http://localhost:3001/main"
NEXT_PUBLIC_SSO_BASE_URL="http://localhost:3000/sso"
NEXT_PUBLIC_MAIN_BASE_URL="http://localhost:3001/main"

# Secret used to sign the SSO session cookie (HS256)
SSO_SESSION_SECRET="sso_session_dev_secret_7f3a91c4"

# Shared key that lets sanapp-main call SSO admin APIs
SSO_ADMIN_KEY="sanapp_admin_dev_key_a1b2c3"

# Key that lets this SSO call sanapp-main APIs (used by the Apps launcher)
MAIN_API_KEY="sanapp_main_api_dev_key_5e8c"

COOKIE_SECURE="false"
BASE_PATH="/sso"
NEXT_PUBLIC_BASE_PATH="/sso"
