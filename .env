# IIPE SSO — local development environment
DATABASE_URL="postgresql://sso_user:sso_dev_password@localhost:5432/sso_db"

# Public URL of this SSO instance (what Apache2 would map to /sso)
SSO_BASE_URL="http://localhost:3000"

# Secret used to sign the SSO session cookie (HS256)
SSO_SESSION_SECRET="sso_session_dev_secret_7f3a91c4"

# Shared key that lets iipe-main call SSO admin APIs
SSO_ADMIN_KEY="iipe_admin_dev_key_a1b2c3"

# Main launcher link shown on the SSO account page
MAIN_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_SSO_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_MAIN_BASE_URL="http://localhost:3001"
COOKIE_SECURE="false"
