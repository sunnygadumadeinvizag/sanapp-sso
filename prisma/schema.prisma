generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------
// IIPE Central SSO — sso_db
// Owns: user identity. Owns nothing about application roles.
// ------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  name         String
  passwordHash String
  role         String     @default("USER") // SUPER_ADMIN | USER
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  authCodes    AuthCode[]
}

// Registered OAuth 2.0 / OIDC clients (the independent applications)
model OidcClient {
  id           String     @id @default(uuid())
  clientId     String     @unique
  clientSecret String
  name         String
  description  String?
  redirectUris String // comma-separated allow-list
  enabled      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  authCodes    AuthCode[]
}

// Single-use, short-lived authorization codes
model AuthCode {
  code        String      @id
  clientId    String
  client      OidcClient  @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri String
  state       String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime    @default(now())
}

// RSA signing key used for RS256 id_tokens / access tokens and JWKS
model SigningKey {
  id         String   @id @default("active")
  privateJwk Json
  publicJwk  Json
  createdAt  DateTime @default(now())
}
